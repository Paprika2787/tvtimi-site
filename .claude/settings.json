{
  "extraKnownMarketplaces": {
    "projet-mere": {
      "source": {
        "source": "github",
        "repo": "Paprika2787/projetMere"
      }
    }
  },
  "enabledPlugins": {
    "socle@projet-mere": true
  },
  "permissions": {
    "allow": [
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git pull *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mktemp *)",
      "Bash(rg *)",
      "Bash(shasum *)",
      "Bash(socle ci *)",
      "Bash(socle diff)",
      "Bash(socle doctor *)",
      "Bash(socle env copier)",
      "Bash(socle image *)",
      "Bash(socle lock *)",
      "Bash(socle secrets *)",
      "Bash(socle temps *)",
      "Bash(socle version)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(xcrun xcresulttool *)"
    ],
    "deny": [
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/.env)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(./**/env/**/*.json)",
      "Read(./**/key.properties)",
      "Read(./*.jks)",
      "Read(./*.keystore)",
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./env/**/*.json)",
      "Read(./key.properties)"
    ]
  }
}
